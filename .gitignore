# Obsidian workspace and cache files
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/
.obsidian/themes/*/

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
~*

# --- Secrets: never commit. Added for THU-29. ---
# A pattern with no slash matches at EVERY depth, not just the repo root.
# That is the point: a subtree-scoped rule is exactly what hid this gap.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
# Private keys, certificates and keystores.
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
# Secret filenames, spelled out. Deliberately NOT `*credentials*`:
# that glob captures legitimate source files (weekschema's credentials.js).
secrets.json
secrets.yml
secrets.yaml
credentials.json
credentials.yml
credentials.yaml
